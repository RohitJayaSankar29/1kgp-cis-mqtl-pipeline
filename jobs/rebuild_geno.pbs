#!/bin/bash
#PBS -N rebuild_geno
#PBS -P cy94
#PBS -q normal
#PBS -l ncpus=4
#PBS -l mem=32GB
#PBS -l walltime=04:00:00
#PBS -l jobfs=200GB
#PBS -l storage=scratch/cy94
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/cy94/rs4477/logs/rebuild_geno.log
set -e
BCF=/scratch/cy94/rs4477/micromamba/envs/mqtl_modkit/bin/bcftools
PL=/scratch/cy94/rs4477/micromamba/envs/plink/bin/plink2
B=/scratch/cy94/rs4477/1kgp-cis-mqtl
CFG=$B/config
declare -A MINPOS=( [chr1]=240000000 [chr7]=155000000 )
for C in chr1 chr7; do
  echo "=== $C ==="
  VCF=$B/genotypes/$C/1kGP_high_coverage_Illumina.${C}.filtered.SNV_INDEL_SV_phased_panel.vcf.gz
  $BCF view -S $CFG/keep_geno_452.txt --force-samples -Oz -o $PBS_JOBFS/sub.vcf.gz $VCF
  LAST=$($BCF query -f "%POS\n" $PBS_JOBFS/sub.vcf.gz | tail -1)
  echo "$C subset last pos: $LAST (need > ${MINPOS[$C]})"
  if [ "$LAST" -lt "${MINPOS[$C]}" ]; then echo "$C SUBSET TRUNCATED - aborting"; exit 1; fi
  $PL --vcf $PBS_JOBFS/sub.vcf.gz --make-bed --output-chr chrM --max-alleles 2 --snps-only just-acgt --rm-dup force-first --set-all-var-ids "@:#:\$r:\$a" --new-id-max-allele-len 100 --maf 0.05 --out $B/genotypes/genome_452/$C/${C}.452samples
  echo "$C built: $(wc -l < $B/genotypes/genome_452/$C/${C}.452samples.bim) variants, last pos $(tail -1 $B/genotypes/genome_452/$C/${C}.452samples.bim | awk "{print \$4}")"
  rm -f $PBS_JOBFS/sub.vcf.gz
done
echo DONE
