#!/bin/bash
#PBS -N tqtl_c22p
#PBS -P cy94
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=96GB
#PBS -l walltime=01:00:00
#PBS -l storage=scratch/cy94
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/cy94/rs4477/logs/tqtl_c22p.log
export MAMBA_EXE=/home/571/rs4477/.local/bin/micromamba
export MAMBA_ROOT_PREFIX=/scratch/cy94/rs4477/micromamba
eval "$($MAMBA_EXE shell hook --shell bash --root-prefix $MAMBA_ROOT_PREFIX)"
micromamba activate mqtl_tensorqtl
module load cuda 2>/dev/null || true
cd /scratch/cy94/rs4477/1kgp-cis-mqtl-pipeline
B=/scratch/cy94/rs4477/1kgp-cis-mqtl
mkdir -p $B/tensorqtl/genome_452/chr22
time python scripts/tensorqtl/05_run_tensorqtl_pilot.py --plink-prefix $B/genotypes/genome_452/chr22/chr22.452samples --phenotype-bed $B/matrix/genome_452_cpgfilt/chr22.methylation_Mval.cpgfilt.bed.gz --covariates $B/covariates/genome_452/chr22.covariates.tsv --nominal-out $B/tensorqtl/genome_452/chr22/nominal_dummy --permutation-out $B/tensorqtl/genome_452/chr22/chr22.permutation.txt.gz --cis-window 1000000 --n-permutations 1000 --region chr22 --skip-nominal
echo DONE
