#!/bin/bash
#PBS -N asm_mwu_test
#PBS -P cy94
#PBS -q normal
#PBS -l ncpus=4
#PBS -l mem=48GB
#PBS -l walltime=02:00:00
#PBS -l storage=scratch/cy94+gdata/xl04
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/cy94/rs4477/logs/asm_mwu_test.log
set -uo pipefail

S=HG00097
BASE=/scratch/cy94/rs4477/1kgp-cis-mqtl
SC=/scratch/cy94/rs4477/cov_v2
MODKIT=/scratch/cy94/rs4477/micromamba/envs/mqtl_modkit/bin/modkit
PY=/scratch/cy94/rs4477/micromamba/envs/mqtl_tensorqtl/bin/python3
REF=/scratch/cy94/rs4477/reference/hg38.fa
REGIONS=$BASE/asm/regions_cpgfilt.bed
HT=$BASE/asm_cpgfilt/$S/$S.htlist.tsv
BAM=$BASE/chr22_bams/$S.chr22.bam

TEST=/scratch/cy94/rs4477/asm_mwu_test; mkdir -p "$TEST"

echo "=== extract calls (original BAM, hp comes from htlist) ==="
"$MODKIT" extract calls --reference "$REF" -t 4 "$BAM" "$TEST/$S.calls.raw.tsv" || exit 1
wc -l "$TEST/$S.calls.raw.tsv"

echo "=== filter + join to regions ==="
"$PY" "$SC/asm_join_calls.py" "$TEST/$S.calls.raw.tsv" "$HT" "$REGIONS" "$TEST/$S.calls.tsv" || exit 1
wc -l "$TEST/$S.calls.tsv"

echo "=== caller: fisher (Atlas, current behaviour) ==="
"$PY" "$SC/asm_readlevel_v2.py" --calls "$TEST/$S.calls.tsv" --regions "$REGIONS" \
  --out "$TEST/$S.fisher.tsv" --stat fisher

echo "=== caller: mwu (continuous) ==="
"$PY" "$SC/asm_readlevel_v2.py" --calls "$TEST/$S.calls.tsv" --regions "$REGIONS" \
  --out "$TEST/$S.mwu.tsv" --stat mwu

echo "=== compare against the original run ==="
echo "original (fisher, q<0.01):"
awk -F'\t' 'NR>1 && $13<0.01' "$BASE/asm_cpgfilt/$S/$S.asm_regions.tsv" | wc -l
