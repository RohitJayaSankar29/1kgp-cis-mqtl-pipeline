#!/bin/bash
#PBS -N func_annot_gw
#PBS -P cy94
#PBS -q normal
#PBS -l ncpus=8
#PBS -l mem=32GB
#PBS -l walltime=03:00:00
#PBS -l storage=scratch/cy94+gdata/cy94
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/cy94/rs4477/logs/func_annot_gw.log
set -uo pipefail
export MAMBA_EXE=/home/571/rs4477/.local/bin/micromamba
export MAMBA_ROOT_PREFIX=/scratch/cy94/rs4477/micromamba
eval "$($MAMBA_EXE shell hook --shell bash --root-prefix $MAMBA_ROOT_PREFIX)"
micromamba activate mqtl_tensorqtl
B=/scratch/cy94/rs4477/1kgp-cis-mqtl
A=/scratch/cy94/rs4477/reference/annotation
G=/g/data/cy94/rs4477/downstream/genome_452
SC=/scratch/cy94/rs4477/cov_v2
TMP=$A/perchrom; mkdir -p $TMP
for N in $(seq 1 22); do
  C=chr$N
  O=$G/$C/functional; mkdir -p $O
  OUT=$O/$C.functional.tsv
  [ -s "$OUT" ] && { echo "$C skip"; continue; }
  awk -v c=$C "\$1==c" $A/gencode_tss_genome.bed > $TMP/$C.tss.bed
  awk -v c=$C "\$1==c" $A/cpg_islands_genome.bed > $TMP/$C.island.bed
  awk -v c=$C "\$1==c" $A/ccre_4col.bed > $TMP/$C.ccre.bed
  echo "=== $C tss=$(wc -l < $TMP/$C.tss.bed) isl=$(wc -l < $TMP/$C.island.bed) ccre=$(wc -l < $TMP/$C.ccre.bed) ==="
  python $SC/functional_annotate.py --matrix $B/matrix/genome_452_cpgfilt/$C.methylation_Mval.cpgfilt.bed.gz --significant-cpgs $B/tensorqtl/genome_452/sig_by_chrom/$C.sig_cpgs.txt --tss-bed $TMP/$C.tss.bed --cpg-island-bed $TMP/$C.island.bed --ccre-bed $TMP/$C.ccre.bed --out $OUT && echo "$C done"
done
echo ALL_FUNC_DONE
