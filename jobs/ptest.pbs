#!/bin/bash
#PBS -N ptest
#PBS -P cy94
#PBS -q normal
#PBS -l ncpus=4
#PBS -l mem=32GB
#PBS -l walltime=03:00:00
#PBS -l storage=scratch/cy94
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/cy94/rs4477/logs/ptest.log
export MAMBA_EXE=/home/571/rs4477/.local/bin/micromamba
export MAMBA_ROOT_PREFIX=/scratch/cy94/rs4477/micromamba
eval "$($MAMBA_EXE shell hook --shell bash --root-prefix $MAMBA_ROOT_PREFIX)"
micromamba activate mqtl_tensorqtl
cd /scratch/cy94/rs4477/1kgp-cis-mqtl-pipeline
B=/scratch/cy94/rs4477/1kgp-cis-mqtl
mkdir -p $B/tensorqtl/genome_452/chunks
time python scripts/tensorqtl/05_run_tensorqtl_pilot.py --plink-prefix $B/genotypes/genome_452/chr22/chr22.452samples --phenotype-bed $B/matrix/genome_452_cpgfilt/chr22.methylation_Mval.cpgfilt.bed.gz --covariates $B/covariates/genome_452/chr22.covariates.tsv --nominal-out $B/tensorqtl/genome_452/chunks/chr22_nd_test --permutation-out $B/tensorqtl/genome_452/chunks/chr22.chunk0of4.permutation.txt.gz --cis-window 1000000 --n-permutations 100 --region chr22 --skip-nominal --n-chunks 4 --chunk-idx 0
echo DONE
