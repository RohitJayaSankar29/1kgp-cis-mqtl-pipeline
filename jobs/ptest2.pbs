#!/bin/bash
#PBS -N ptest2
#PBS -P cy94
#PBS -q normal
#PBS -l ncpus=2
#PBS -l mem=16GB
#PBS -l walltime=06:00:00
#PBS -l storage=scratch/cy94
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/cy94/rs4477/logs/ptest2.log
export MAMBA_EXE=/home/571/rs4477/.local/bin/micromamba
export MAMBA_ROOT_PREFIX=/scratch/cy94/rs4477/micromamba
eval "$($MAMBA_EXE shell hook --shell bash --root-prefix $MAMBA_ROOT_PREFIX)"
micromamba activate mqtl_tensorqtl
cd /scratch/cy94/rs4477/1kgp-cis-mqtl-pipeline
B=/scratch/cy94/rs4477/1kgp-cis-mqtl
python scripts/tensorqtl/05_run_tensorqtl_pilot.py --plink-prefix $B/genotypes/genome_452/chr7/chr7.452samples --phenotype-bed $B/matrix/genome_452_cpgfilt/chr7.methylation_Mval.cpgfilt.bed.gz --covariates $B/covariates/genome_452/chr7.covariates.tsv --nominal-out $B/tensorqtl/genome_452/chunks/chr7_nd_c0 --permutation-out $B/tensorqtl/genome_452/chunks/chr7.chunk0of11.permutation.txt.gz --cis-window 1000000 --n-permutations 100 --region chr7 --skip-nominal --n-chunks 11 --chunk-idx 0
echo DONE
