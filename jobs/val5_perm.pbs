#!/bin/bash
#PBS -N val5_perm
#PBS -P cy94
#PBS -q express
#PBS -l ncpus=4
#PBS -l mem=16GB
#PBS -l walltime=00:30:00
#PBS -l jobfs=10GB
#PBS -l storage=gdata/xl04+scratch/cy94
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/cy94/rs4477/val5_perm.log

set -uo pipefail
eval "$(micromamba shell hook --shell bash)"
micromamba activate mqtl_tensorqtl
cd /scratch/cy94/rs4477/1kgp_tensorqtl_fix

GENO=/g/data/xl04/rs4477/1kgp-cis-mqtl/genotypes/chr22_5samples/chr22.5samples
PHENO=/g/data/xl04/rs4477/1kgp-cis-mqtl/matrix/chr22_5samples_tensorqtl/methylation_Mval.bed.gz
COV=/g/data/xl04/rs4477/1kgp-cis-mqtl/covariates/chr22_5samples/covariates.tsv
OUT=/scratch/cy94/rs4477/1kgp-cis-mqtl/tensorqtl/chr22_5s
mkdir -p $OUT/permutation

echo "=== whoami ==="; whoami
echo "=== data dir ==="; ls -d /g/data/xl04/*/1kgp-cis-mqtl 2>/dev/null
echo "=== chrom check ==="
echo -n "genotype:  "; head -1 $GENO.bim | cut -f1
echo -n "phenotype: "; zcat $PHENO | head -1 | cut -f1

echo "=== running 05a ==="
python scripts/tensorqtl/05a_run_permutation.py \
  --plink-prefix $GENO \
  --phenotype-bed $PHENO \
  --covariates $COV \
  --out $OUT/permutation/chr22.perm.txt.gz \
  --cis-window 1000000 \
  --maf-threshold 0.1 \
  --n-permutations 1000 \
  --threads 4
echo "=== done, exit $? ==="
