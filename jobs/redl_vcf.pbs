#!/bin/bash
#PBS -N redl_vcf
#PBS -P cy94
#PBS -q copyq
#PBS -l ncpus=1
#PBS -l mem=4GB
#PBS -l walltime=05:00:00
#PBS -l storage=scratch/cy94
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/cy94/rs4477/logs/redl_vcf.log
set -e
URL=https://ftp.1000genomes.ebi.ac.uk/vol1/ftp/data_collections/1000G_2504_high_coverage/working/20220422_3202_phased_SNV_INDEL_SV
BCF=/scratch/cy94/rs4477/micromamba/envs/mqtl_modkit/bin/bcftools
for C in chr1 chr7; do
  echo "=== $C ==="
  F=1kGP_high_coverage_Illumina.${C}.filtered.SNV_INDEL_SV_phased_panel.vcf.gz
  D=/scratch/cy94/rs4477/1kgp-cis-mqtl/genotypes/$C
  wget -O $D/${F}.new $URL/$F
  wget -O $D/${F}.new.tbi $URL/${F}.tbi
  echo "$C testing integrity (full sequential read)..."
  if $BCF view $D/${F}.new -Ou 2>/dev/null | $BCF view -H 2>/dev/null | tail -1 | cut -f1,2; then
    mv $D/${F}.new $D/$F; mv $D/${F}.new.tbi $D/${F}.tbi; echo "$C OK - replaced"
  else
    echo "$C new file also failed integrity"; fi
done
echo DONE
