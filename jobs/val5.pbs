#!/bin/bash
#PBS -N val5
#PBS -P cy94
#PBS -q express
#PBS -l ncpus=4
#PBS -l mem=16GB
#PBS -l walltime=01:00:00
#PBS -l jobfs=10GB
#PBS -l storage=gdata/xl04+scratch/cy94
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/cy94/rs4477/val5.log

set -uo pipefail
PYBIN=/scratch/cy94/rs4477/micromamba/envs/mqtl_tensorqtl/bin/python3
cd /scratch/cy94/rs4477/1kgp_tensorqtl_fix

SRC=/g/data/xl04/rs4477/1kgp-cis-mqtl/genotypes/chr22_5samples
DST=/scratch/cy94/rs4477/1kgp-cis-mqtl/genotypes/chr22_5samples
mkdir -p $DST
cp -f $SRC/chr22.5samples.{bed,bim,fam} $DST/
GENO=$DST/chr22.5samples

FULL=/g/data/xl04/rs4477/1kgp-cis-mqtl/matrix/chr22_5samples_tensorqtl/methylation_Mval.bed.gz
SMALL=/scratch/cy94/rs4477/1kgp-cis-mqtl/matrix/val_slice.bed.gz
mkdir -p $(dirname $SMALL)
zcat $FULL | head -201 | gzip > $SMALL     # header + 200 CpGs

COV=/g/data/xl04/rs4477/1kgp-cis-mqtl/covariates/chr22_5samples/covariates.tsv
OUT=/scratch/cy94/rs4477/1kgp-cis-mqtl/tensorqtl/chr22_5s
mkdir -p $OUT/permutation $OUT/fdr $OUT/nominal

echo "=== chrom check ==="
echo "geno:  $(head -1 $GENO.bim | cut -f1)"
echo "pheno: $(zcat $SMALL | sed -n '2p' | cut -f1)"

echo "=== Stage 1: permutation (200 CpGs, nperm=100) ==="
$PYBIN scripts/tensorqtl/05a_run_permutation.py \
  --plink-prefix $GENO --phenotype-bed $SMALL --covariates $COV \
  --out $OUT/permutation/val.perm.txt.gz \
  --cis-window 1000000 --maf-threshold 0.1 --n-permutations 100 --threads 4

echo "=== Stage 2: FDR ==="
$PYBIN scripts/tensorqtl/05b_fdr_significant.py \
  --permutation $OUT/permutation/val.perm.txt.gz \
  --out-dir $OUT/fdr --label val.chr22 --fdr 0.05

echo "=== Stage 3: nominal for significant ==="
$PYBIN scripts/tensorqtl/05c_run_nominal_significant.py \
  --plink-prefix $GENO --phenotype-bed $SMALL --covariates $COV \
  --significant-cpgs $OUT/fdr/val.chr22.significant_cpgs.txt \
  --out-dir $OUT/nominal --prefix val.chr22.sig \
  --cis-window 1000000 --maf-threshold 0.1 --threads 4
echo "=== ALL DONE ==="
